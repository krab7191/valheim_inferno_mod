<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The BepInEx plugin: thin glue between the game and Inferno.Core.
    Game assemblies are referenced from the local Valheim install ($(ValheimDir), set in Directory.Build.user.props)
    and are never copied to the output or committed.
  -->
  <PropertyGroup>
    <!-- Valheim runs on Unity Mono with the .NET Framework 4.x API set. -->
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>Inferno</AssemblyName>
    <RootNamespace>Inferno</RootNamespace>
    <!-- No XML doc file: the plugin has no public API (and BepInEx.PluginInfoProps generates undocumented members). -->
    <!-- Feeds the generated MyPluginInfo class, so the plugin version always equals <Version>. -->
    <BepInExPluginGuid>GrundleLord.Inferno</BepInExPluginGuid>
    <BepInExPluginName>Inferno</BepInExPluginName>
    <ValheimManagedDir>$(ValheimDir)/valheim_Data/Managed</ValheimManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Core" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="BepInEx.Analyzers" PrivateAssets="all" />
    <PackageReference Include="BepInEx.PluginInfoProps" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Inferno.Core/Inferno.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="assembly_valheim" HintPath="$(ValheimManagedDir)/assembly_valheim.dll" Private="false" />
    <Reference Include="assembly_utils" HintPath="$(ValheimManagedDir)/assembly_utils.dll" Private="false" />
    <Reference Include="assembly_guiutils" HintPath="$(ValheimManagedDir)/assembly_guiutils.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(ValheimManagedDir)/UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ValheimManagedDir)/UnityEngine.CoreModule.dll" Private="false" />
  </ItemGroup>

  <Target Name="CheckValheimDir" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(ValheimDir)' == '' Or !Exists('$(ValheimManagedDir)/assembly_valheim.dll')"
           Text="Valheim not found. Copy Directory.Build.user.props.example to Directory.Build.user.props and set ValheimDir. (Core + tests do not need the game: run 'dotnet test tests/Inferno.Core.Tests'.)" />
  </Target>

  <!-- Release builds produce artifacts/Inferno-<version>.zip, laid out to unzip straight into the Valheim folder. -->
  <!-- The README is the Thunderstore page: it must describe the version being released (checked before any package). -->
  <Target Name="CheckReleaseDocs" AfterTargets="Build" BeforeTargets="PackagePlugin;PackageThunderstore" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <DocsRoot>$(MSBuildThisFileDirectory)../../</DocsRoot>
    </PropertyGroup>
    <Error Condition="!$([System.IO.File]::ReadAllText('$(DocsRoot)README.md').Contains('| $(Version) |'))" Text="README.md has no compatibility row for $(Version). Update the README (= Thunderstore page) for this version before packaging." />
    <Error Condition="!$([System.IO.File]::ReadAllText('$(DocsRoot)CHANGELOG.md').Contains('## [$(Version)]'))" Text="CHANGELOG.md has no '## [$(Version)]' section. Add one before packaging." />
  </Target>

  <Target Name="PackagePlugin" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <PackageRoot>$(MSBuildThisFileDirectory)../../artifacts/package/</PackageRoot>
      <PackageZip>$(MSBuildThisFileDirectory)../../artifacts/Inferno-$(Version).zip</PackageZip>
    </PropertyGroup>
    <RemoveDir Directories="$(PackageRoot)" />
    <Copy SourceFiles="$(TargetDir)Inferno.dll;$(TargetDir)Inferno.Core.dll" DestinationFolder="$(PackageRoot)BepInEx/plugins/Inferno" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)../../README.md;$(MSBuildThisFileDirectory)../../CHANGELOG.md;$(MSBuildThisFileDirectory)../../LICENSE;$(MSBuildThisFileDirectory)../../docs/sample-config.cfg" DestinationFolder="$(PackageRoot)BepInEx/plugins/Inferno" />
    <Delete Files="$(PackageZip)" />
    <ZipDirectory SourceDirectory="$(PackageRoot)" DestinationFile="$(PackageZip)" />
    <Message Importance="high" Text="Inferno package: $(PackageZip)" />
  </Target>

  <!--
    Release builds also produce artifacts/GrundleLord-Inferno-<version>.zip for Thunderstore (upload it on
    thunderstore.io under team GrundleLord). The manifest is generated so its version always equals <Version>.
  -->
  <PropertyGroup>
    <ThunderstoreTeam>GrundleLord</ThunderstoreTeam>
    <ThunderstoreDescription>Server-side fire control: torches, fires, hearths and hot tubs stay lit with no refuelling, plus burn rate and day/night schedules. Players install nothing, so it works with crossplay (Xbox, PlayStation).</ThunderstoreDescription>
    <ThunderstoreDependency>denikson-BepInExPack_Valheim-5.4.2351</ThunderstoreDependency>
    <ThunderstoreWebsite>https://github.com/krab7191/valheim_inferno_mod</ThunderstoreWebsite>
  </PropertyGroup>

  <!-- Thunderstore rejects files with a UTF-8 byte-order mark; WriteLinesToFile always adds one. -->
  <UsingTask TaskName="WriteUtf8NoBom" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <File ParameterType="System.String" Required="true" />
      <Text ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        System.IO.File.WriteAllText(File, Text.Replace("\r\n", "\n"), new System.Text.UTF8Encoding(false));
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="PackageThunderstore" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <RepoRoot>$(MSBuildThisFileDirectory)../../</RepoRoot>
      <TsRoot>$(RepoRoot)artifacts/thunderstore/</TsRoot>
      <TsZip>$(RepoRoot)artifacts/$(ThunderstoreTeam)-Inferno-$(Version).zip</TsZip>
      <ReadmeSource>$([System.IO.File]::ReadAllText('$(RepoRoot)README.md'))</ReadmeSource>
      <!-- Drop the developer section (relative links to repo files don't work on Thunderstore). -->
      <ReadmeThunderstore>$([System.Text.RegularExpressions.Regex]::Replace($(ReadmeSource), '&lt;!-- thunderstore:exclude-start --&gt;[\s\S]*?&lt;!-- thunderstore:exclude-end --&gt;\s*', ''))</ReadmeThunderstore>
      <TsManifest>{
  "name": "Inferno",
  "version_number": "$(Version)",
  "website_url": "$(ThunderstoreWebsite)",
  "description": "$(ThunderstoreDescription)",
  "dependencies": [ "$(ThunderstoreDependency)" ]
}</TsManifest>
    </PropertyGroup>
    <Error Condition="$(ThunderstoreDescription.Length) &gt; 250" Text="Thunderstore description must be at most 250 characters (is $(ThunderstoreDescription.Length))." />
    <RemoveDir Directories="$(TsRoot)" />
    <MakeDir Directories="$(TsRoot)plugins" />
    <WriteUtf8NoBom File="$(TsRoot)manifest.json" Text="$(TsManifest)" />
    <WriteUtf8NoBom File="$(TsRoot)README.md" Text="$(ReadmeThunderstore)" />
    <Copy SourceFiles="$(RepoRoot)assets/icon.png;$(RepoRoot)CHANGELOG.md;$(RepoRoot)LICENSE" DestinationFolder="$(TsRoot)" />
    <Copy SourceFiles="$(TargetDir)Inferno.dll;$(TargetDir)Inferno.Core.dll;$(RepoRoot)docs/sample-config.cfg" DestinationFolder="$(TsRoot)plugins" />
    <Delete Files="$(TsZip)" />
    <ZipDirectory SourceDirectory="$(TsRoot)" DestinationFile="$(TsZip)" />
    <Message Importance="high" Text="Thunderstore package: $(TsZip)" />
  </Target>

  <Target Name="DeployPlugin" AfterTargets="Build" Condition="'$(InfernoDeployDir)' != ''">
    <Copy SourceFiles="$(TargetDir)Inferno.dll;$(TargetDir)Inferno.Core.dll" DestinationFolder="$(InfernoDeployDir)" />
    <Message Importance="high" Text="Inferno deployed to $(InfernoDeployDir)" />
  </Target>
</Project>
